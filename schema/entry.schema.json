{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/ai-chat-anomaly-log/schema/entry.schema.json",
  "title": "AI Chat Anomaly Log entry",
  "description": "GENERATED from schema/options.json by `npm run generate`. Do not edit by hand. One incident per file at data/entries/<id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "date",
    "assistant",
    "account_type",
    "trigger_prompt",
    "behavior_type",
    "severity",
    "excerpt",
    "reproduced"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]{6}$",
      "description": "Entry id: the incident date plus a 6-character random suffix. Must match the file name."
    },
    "date": {
      "type": "string",
      "description": "Date the behavior occurred (YYYY-MM-DD).",
      "minLength": 1,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "format": "date"
    },
    "assistant": {
      "type": "string",
      "description": "Which assistant produced the behavior.",
      "enum": [
        "ChatGPT",
        "Claude",
        "Claude Code",
        "Codex",
        "Copilot",
        "Gemini",
        "WoS RA",
        "Other"
      ]
    },
    "assistant_other": {
      "type": "string",
      "description": "Required only when Assistant is Other.",
      "minLength": 1,
      "maxLength": 100
    },
    "model_version": {
      "type": "string",
      "description": "As shown in the UI, if visible.",
      "minLength": 1,
      "maxLength": 100
    },
    "account_type": {
      "type": "string",
      "description": "Type of account used.",
      "enum": [
        "Paid",
        "Free",
        "Academic / Institutional"
      ]
    },
    "task_domain": {
      "type": "string",
      "description": "What kind of work you were doing.",
      "enum": [
        "Research",
        "Reference / fact-check",
        "Coding",
        "Writing / editing",
        "Data analysis",
        "General chat",
        "Other"
      ]
    },
    "features_on": {
      "type": "string",
      "description": "Web search, memory, tools, file uploads, etc.",
      "minLength": 1,
      "maxLength": 300
    },
    "custom_instructions": {
      "type": "string",
      "description": "Custom instructions or system prompt used, if any. Redact anything personal.",
      "minLength": 1,
      "maxLength": 2000
    },
    "trigger_prompt": {
      "type": "string",
      "description": "The prompt that triggered the behavior. Redact personal or confidential details.",
      "minLength": 1,
      "maxLength": 4000
    },
    "behavior_type": {
      "type": "string",
      "description": "The main kind of odd behavior.",
      "enum": [
        "Instruction drift",
        "Fabrication",
        "Odd refusal / over-caution",
        "Self-contradiction",
        "Caving / reversal under pushback",
        "Identity / persona / tone"
      ]
    },
    "behavior_type_secondary": {
      "type": "string",
      "description": "Optional second type. Must differ from the primary type.",
      "enum": [
        "Instruction drift",
        "Fabrication",
        "Odd refusal / over-caution",
        "Self-contradiction",
        "Caving / reversal under pushback",
        "Identity / persona / tone"
      ]
    },
    "severity": {
      "type": "string",
      "description": "How much it mattered.",
      "enum": [
        "Minor",
        "Moderate",
        "Major"
      ]
    },
    "excerpt": {
      "type": "string",
      "description": "The odd part of the response, max 1,500 characters. Quote only what is needed.",
      "minLength": 1,
      "maxLength": 1500
    },
    "chat_link": {
      "type": "string",
      "description": "Shared-chat link, if public. Links to private chats won't work for others, and a shared link can expose the whole conversation.",
      "minLength": 1,
      "pattern": "^https://\\S+$",
      "format": "uri",
      "maxLength": 500
    },
    "reproduced": {
      "type": "string",
      "description": "Did you retry, and did it happen again?",
      "enum": [
        "Reproduced",
        "Not reproduced",
        "Untested"
      ]
    },
    "notes": {
      "type": "string",
      "description": "Anything else that helps a reader understand the incident.",
      "minLength": 1,
      "maxLength": 2000
    },
    "example": {
      "type": "boolean",
      "description": "true = format example only; shown on Browse but excluded from the dashboard and CSV."
    },
    "source_issue": {
      "type": "integer",
      "minimum": 1,
      "description": "Issue number this entry was created from, if any."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assistant": {
            "const": "Other"
          }
        },
        "required": [
          "assistant"
        ]
      },
      "then": {
        "required": [
          "assistant_other"
        ]
      },
      "else": {
        "not": {
          "required": [
            "assistant_other"
          ]
        }
      }
    }
  ]
}
